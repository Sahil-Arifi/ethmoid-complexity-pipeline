{
  "schema_version": 1,
  "protocol_version": "ethmoid-count-prototype-v1",
  "status": "EXPERIMENTAL_NOT_CLINICALLY_VALIDATED",
  "training_eligibility": "NOT_FOR_TRAINING",
  "endpoint": "unique_anatomical_cell_instances_across_full_3d_volume",
  "first_result": "fully_automatic_without_patient_specific_prompts",
  "outputs": ["left_count", "right_count", "total_count", "cell_registry", "cavity_instances", "air_instances"],
  "instance_dtype": "uint16",
  "air_mask_required_for_each_cell": false,
  "count_opacified_cells": true,
  "included_variants": ["agger_nasi", "haller", "onodi", "frontal_region", "supraorbital_ethmoid", "concha_bullosa"],
  "excluded_measurements": ["2d_landmark_counts", "anterior_posterior_counts", "composite_complexity_score", "cell_volume_distribution", "surface_area_ratio"],
  "maximum_slice_thickness_mm": 1.0,
  "clinical_exclusions": ["previous_sinus_surgery", "severe_disease", "distorted_anatomy", "pediatric_anatomy", "artifacts", "incomplete_coverage"],
  "unknown_eligibility": "exploratory_only_not_a_clinical_pass",
  "reference_counts_required_for_inference": false,
  "reference_counts_required_for_accuracy_claim": true,
  "failure_policy": "no_numeric_count_on_failed_localization_or_geometry",
  "assumptions": {
    "cell_separation": "supported_septum_overrides_air_connectivity; communication_without_supported_septum_is_one_cell",
    "frontal": "frontal_region_cells_not_main_frontal_sinus",
    "boundaries": "explicit_variant_inclusions_override_nominal_core_envelope",
    "inferior_boundary": "bony_orbital_floor_not_eyeball_bottom",
    "midline": "anatomical_laterality_with_crossing_candidates_flagged_for_review",
    "opacity": "cavity_identity_separate_from_air_content; uncertain_bone_bounded_candidates_flagged"
  },
  "provenance": {
    "latest_sources": ["Ethmoid Protocol v2 1.docx.pdf", "clinician_email_clarifying_full_volume_preliminary_counts"],
    "earlier_workflow_source": "ML Component Questions.pdf",
    "authority": "prototype_assumptions_authorized_by_project_owner; not_clinical_signoff"
  }
}
